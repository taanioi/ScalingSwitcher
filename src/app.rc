#include <winuser.h>
#include <winver.h>

#define IDI_APP_ICON 101

IDI_APP_ICON ICON "app.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "taanioi\0"
            VALUE "FileDescription",  "Lightweight Native NVIDIA Display Scaling Switcher\0"
            VALUE "FileVersion",      "1.0.0.0\0"
            VALUE "InternalName",     "ScalingSwitcher\0"
            VALUE "OriginalFilename", "ScalingSwitcher.exe\0"
            VALUE "ProductName",      "Scaling Switcher\0"
            VALUE "ProductVersion",   "1.0.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
